---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allPosts = await getCollection('blog', ({ data, id }) => !data.draft && !id.endsWith('.draft.md'));
const allPostsData = allPosts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
}));

const accounts = [
  {
    platform: 'GitHub',
    handle: 'github.com/amaanx86',
    url: 'https://github.com/amaanx86',
    notes: 'Primary OSS account',
  },
  {
    platform: 'GitLab',
    handle: 'gitlab.com/amaanx86',
    url: 'https://gitlab.com/amaanx86',
    notes: 'OSS & work projects',
  },
  {
    platform: 'LinkedIn',
    handle: 'linkedin.com/in/amaanulhaqsiddiqui',
    url: 'https://www.linkedin.com/in/amaanulhaqsiddiqui/',
    notes: 'Professional',
  },
  {
    platform: 'AWS Builder ID',
    handle: 'builder.aws.com/community/@amaan100x',
    url: 'https://builder.aws.com/community/@amaan100x',
    notes: 'AWS community profile',
  },
  {
    platform: 'LF Open Profile',
    handle: 'openprofile.dev/profile/amaanulhaq',
    url: 'https://openprofile.dev/profile/amaanulhaq',
    notes: 'Linux Foundation / CNCF identity',
  },
  {
    platform: 'Credly',
    handle: 'credly.com/users/amaanx86',
    url: 'https://www.credly.com/users/amaanx86',
    notes: 'Certifications & badges',
  },
  {
    platform: 'DEV.to',
    handle: 'dev.to/amaanx86',
    url: 'https://dev.to/amaanx86',
    notes: 'Technical writing',
  },
  {
    platform: 'Reddit',
    handle: 'u/The404Engineer',
    url: 'https://reddit.com/user/The404Engineer/',
    notes: 'Technical discussions',
  },
  {
    platform: 'Email',
    handle: 'amaanulhaq.s@outlook.com',
    url: null,
    notes: 'PGP-signed preferred',
  },
];

const corporateKeys = [
  {
    org: 'SUDO Consultants',
    keyId: '0B1255FF6B0D509B',
    algorithm: 'RSA 4096',
    keyserver:
      'https://keyserver.ubuntu.com/pks/lookup?search=amaan%40sudoconsultants.com&fingerprint=on&op=index',
  },
  {
    org: 'MISK Foundation',
    keyId: 'A1FA15D51F6C8D6D',
    algorithm: 'RSA 4096',
    keyserver:
      'https://keyserver.ubuntu.com/pks/lookup?search=v-aman.siddiqui%40misk.org.sa&fingerprint=on&op=index',
  },
];

const imposterSteps = [
  'Report the account to the platform immediately.',
  "Cross-reference the imposter's claims against the accounts listed on this page.",
  'Contact me directly by email if you have security concerns.',
  'Do not trust an unverified GPG signature. Verify against the fingerprint above.',
];
---

<Base
  title="Verify my identity | Amaan Ul Haq Siddiqui"
  description="Canonical record of Amaan Ul Haq Siddiqui's online presence and cryptographic identity."
  allPosts={allPostsData}
>
  <div class="stack">
    <header>
      <h1 class="page-title">Verify</h1>
      <p class="page-lede" style="margin-top:1.25rem">
        This page is the canonical record of my online presence and cryptographic identity. Use it
        to defend against phishing, verify signed commits, and authenticate encrypted mail.
        If an account is not listed here, it is not me.
      </p>
    </header>

    <!-- ── 01 Personal key ──────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">01</span>
        <h2>Personal key</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <div class="panel">
        <div class="key-grid">
          <div>
            <p class="label">Key ID</p>
            <code class="key-value is-accent">FC47DEE803DB612A</code>
          </div>
          <div>
            <p class="label">Algorithm</p>
            <code class="key-value">RSA 4096</code>
          </div>
          <div>
            <p class="label">Email</p>
            <code class="key-value">amaanulhaq.s@outlook.com</code>
          </div>
        </div>

        <div class="fingerprint-block">
          <p class="label">Full fingerprint</p>
          <code class="fingerprint">9A1D B246 6C1A 9E94 F7DF&nbsp;&nbsp;38C3 FC47 DEE8 03DB 612A</code>
        </div>

        <div class="key-actions">
          <a
            class="ghost-btn"
            href="https://keyserver.ubuntu.com/pks/lookup?search=amaanulhaq.s%40outlook.com&fingerprint=on&op=index"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 3H3a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-4M10 1h5v5M15 1L7 9" />
            </svg>
            Keyserver lookup
          </a>
          <a class="ghost-btn" href="/amaan.asc" download>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 1v9M5 7l3 3 3-3M2 12v1a2 2 0 002 2h8a2 2 0 002-2v-1" />
            </svg>
            Download .asc
          </a>
          <button class="ghost-btn" id="copy-fpr" type="button">Copy fingerprint</button>
        </div>

        <p class="entry-summary" style="margin-top:1rem;padding-top:0.9rem;border-top:1px solid var(--border)">
          Use this key to verify signed commits, releases, and encrypted mail. Never trust an
          unsigned claim. Always check against the fingerprint above.
        </p>
      </div>
    </section>

    <!-- ── 02 Corporate keys ────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">02</span>
        <h2>Corporate keys</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <div class="grid-2">
        {corporateKeys.map((key) => (
          <article class="panel">
            <p class="entry-name" style="margin-bottom:0.85rem">{key.org}</p>
            <div class="key-grid">
              <div>
                <p class="label">Key ID</p>
                <code class="key-value is-accent">{key.keyId}</code>
              </div>
              <div>
                <p class="label">Algorithm</p>
                <code class="key-value">{key.algorithm}</code>
              </div>
            </div>
            <div class="entry-foot">
              <span></span>
              <div class="entry-links">
                <a href={key.keyserver} target="_blank" rel="noopener noreferrer">
                  <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 3H3a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-4M10 1h5v5M15 1L7 9" />
                  </svg>
                  keyserver
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ── 03 Verified accounts ─────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">03</span>
        <h2>Verified accounts</h2>
        <span class="rule" aria-hidden="true"></span>
        <span class="action">{accounts.length} listed</span>
      </div>

      <div class="panel panel-flush">
        {accounts.map((acct) => (
          <div class="defrow">
            <span class="dt">{acct.platform}</span>
            <span class="dd">
              {acct.url ? (
                <a href={acct.url} target="_blank" rel="me noopener noreferrer" class="account-handle">{acct.handle}</a>
              ) : (
                <span class="account-handle is-plain">{acct.handle}</span>
              )}
              <span class="account-note">{acct.notes}</span>
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 04 Imposters ─────────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">04</span>
        <h2>If you find an imposter</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <ol class="steps">
        {imposterSteps.map((step, i) => (
          <li>
            <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── Provenance ───────────────────────────────────────────────── -->
    <section>
      <div class="panel panel-quiet">
        <p class="entry-summary">
          This page is served from{' '}
          <a href="https://github.com/amaanx86/amaanx86.github.io" target="_blank" rel="noopener noreferrer" class="link">github.com/amaanx86/amaanx86.github.io</a>{' '}
          and can be checked against the commit history. The canonical URL is
          <code>https://amaanx86.github.io/verify</code>, and key
          <code>FC47DEE803DB612A</code> is also published on the Ubuntu keyserver.
        </p>
      </div>
    </section>
  </div>

  <script>
    const FINGERPRINT = '9A1D B246 6C1A 9E94 F7DF 38C3 FC47 DEE8 03DB 612A';
    const copyBtn = document.getElementById('copy-fpr');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(FINGERPRINT).then(() => {
        copyBtn.textContent = 'Copied';
        setTimeout(() => { copyBtn.textContent = 'Copy fingerprint'; }, 1800);
      });
    });
  </script>
</Base>
