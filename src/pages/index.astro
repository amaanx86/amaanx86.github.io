---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allPosts = await getCollection('blog', ({ data, id }) => !data.draft && !id.endsWith('.draft.md'));
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const allPostsData = allPosts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
}));

const certifications = [
  { name: 'Oracle Cloud Infrastructure Certified Architect Associate', window: 'Aug 2026 - Aug 2028' },
  { name: 'Claude Certified Architect - Foundations', window: 'Jul 2026 - Jul 2027' },
  { name: 'AWS Certified Security - Specialty', window: 'May 2026 - May 2029' },
  { name: 'GCP Professional Cloud Architect', window: 'Jan 2026 - Jan 2028' },
  { name: 'AWS Certified DevOps Engineer - Professional', window: 'Aug 2025 - Aug 2028' },
  { name: 'AWS Certified Solutions Architect - Associate', window: 'Jun 2025 - Jun 2028' },
  { name: 'AWS Certified Cloud Practitioner', window: 'Apr 2025 - Aug 2028' },
];

const stack = [
  'AWS', 'OCI', 'Azure', 'Cloudflare', 'Kubernetes', 'Cilium',
  'Terraform', 'Ansible', 'Prometheus', 'Go', 'Python',
];

const socials = [
  { href: 'https://github.com/amaanx86', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/amaanulhaqsiddiqui/', label: 'LinkedIn' },
  { href: 'https://www.credly.com/users/amaanx86', label: 'Credly' },
];
---

<Base
  title="Amaan Ul Haq Siddiqui | DevOps & Cloud Security Engineer"
  description="DevOps & Cloud Security Engineer building infrastructure at scale across AWS, OCI & Azure. Observability, platform security, and open source tooling."
  allPosts={allPostsData}
>
  <div class="stack">

    <!-- ── Masthead ─────────────────────────────────────────────────── -->
    <header>
      <div class="masthead-eyebrow">
        <span class="meta">
          <span class="pulse" aria-hidden="true"></span>
          Currently at{' '}
          <a href="https://sudoconsultants.com" target="_blank" rel="noopener noreferrer" class="link">SUDO Consultants</a>,{' '}
          AWS Premier Implementation Partner
        </span>
      </div>

      <h1 class="page-title">Amaan Ul Haq Siddiqui</h1>

      <div class="masthead-eyebrow" style="margin-top:1.25rem;margin-bottom:1.75rem">
        <span class="masthead-role">DevOps &amp; Cloud Security Engineer</span>
        <span class="meta" aria-hidden="true">/</span>
        <span class="meta">Karachi, Pakistan</span>
      </div>

      <p class="page-lede">
        Building infrastructure at scale across AWS, OCI, and Azure. Designing observability
        stacks, hardening platform security, and shipping open source tooling that fills real gaps.
      </p>

      <p class="page-lede" style="font-size:0.9rem;margin-top:1rem;color:var(--text-faint)">
        Multi-cloud infrastructure, enterprise observability, large-scale migrations, and platform
        security for an AWS Premier Implementation Partner and MSP.
      </p>

      <nav class="masthead-links" style="margin-top:2rem" aria-label="Elsewhere">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="me noopener noreferrer">{s.label}</a>
        ))}
        <a href="/blog" class="is-primary">
          Read the writing
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </a>
      </nav>
    </header>

    <!-- ── 01 Certifications ────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">01</span>
        <h2>Certifications</h2>
        <span class="rule" aria-hidden="true"></span>
        <a class="action" href="https://www.credly.com/users/amaanx86" target="_blank" rel="noopener noreferrer">Credly</a>
      </div>

      <div class="panel panel-flush">
        {certifications.map((cert) => (
          <div class="listrow">
            <span class="listrow-main">{cert.name}</span>
            <span class="listrow-side">{cert.window}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 02 Community ─────────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">02</span>
        <h2>Community</h2>
        <span class="rule" aria-hidden="true"></span>
        <a class="action" href="/projects#cncg">Chapter details</a>
      </div>

      <a href="/projects#cncg" class="panel panel-link">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <p class="row-title">Cloud Native Karachi</p>
            <p class="meta" style="margin-top:0.3rem">CNCF Community Group &middot; Karachi, Pakistan</p>
          </div>
          <span class="badge badge-blue">Founding organizer</span>
        </div>
        <p class="row-desc" style="margin-top:0.85rem">
          Founding organizer of the city's first official CNCF Community Group, approved
          22 July 2026 after clearing LFC102, vendor-neutrality, and organizer-diversity review.
        </p>
      </a>
    </section>

    <!-- ── 03 Stack ─────────────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">03</span>
        <h2>Stack</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <div class="stack-tags">
        {stack.map((item) => <span class="tag">{item}</span>)}
      </div>
    </section>

    <!-- ── 04 Recent writing ────────────────────────────────────────── -->
    {recentPosts.length > 0 && (
      <section>
        <div class="section-head">
          <span class="idx">04</span>
          <h2>Recent writing</h2>
          <span class="rule" aria-hidden="true"></span>
          <a class="action" href="/blog">All {allPosts.length} posts</a>
        </div>

        <div>
          {recentPosts.map((post) => {
            const readingTime = Math.ceil((post.body ?? '').split(/\s+/).length / 200);
            const formattedDate = post.data.date.toLocaleDateString('en-GB', {
              year: 'numeric', month: 'short', day: '2-digit',
            });
            return (
              <a href={`/blog/${post.id}`} class="row">
                <time class="row-meta" datetime={post.data.date.toISOString()}>{formattedDate}</time>
                <div>
                  <h3 class="row-title">{post.data.title}</h3>
                  <p class="row-desc line-clamp-2">{post.data.description}</p>
                  <div class="row-tail">
                    <span class="meta">{readingTime} min</span>
                    {post.data.tags.slice(0, 3).map((tag: string) => <span class="tag">{tag}</span>)}
                  </div>
                </div>
                <svg class="row-arrow" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </a>
            );
          })}
        </div>
      </section>
    )}

  </div>
</Base>
