const iconFor = (slug: string | null | undefined) => {
  if (!slug) return null;
  if (customIcons[slug]) return customIcons[slug];
  const key = 'si' + slug.charAt(0).toUpperCase() + slug.slice(1).toLowerCase();
  const icon = (simpleIcons as Record<string, { svg: string; hex: string; title: string } | undefined>)[key];
  return icon ?? null;
};

const allPosts = await getCollection('blog', ({ data, id }) => !data.draft && !id.endsWith('.draft.md'));
const allPostsData = allPosts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
}));

