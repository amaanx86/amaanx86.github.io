---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { iconFor } from '../lib/icons';
import { a, contributions } from '../data/contributions';

const allPosts = await getCollection('blog', ({ data, id }) => !data.draft && !id.endsWith('.draft.md'));
const allPostsData = allPosts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
}));

const recognition = [
  {
    title: 'AWS Community Day Dubai',
    date: 'October 2025',
    location: 'Dubai Knowledge Park, UAE',
    description: 'Spoke to ~200 practitioners on resilient AWS architectures and CI/CD security. Based on production patterns from client work and the HackOps win.',
    link: null,
    badge: 'Speaker',
    badgeClass: 'badge-blue',
  },
  {
    title: 'HackOps 2025: 1st Place',
    date: 'April 2025',
    location: 'FAST NUCES, Karachi',
    description: 'First place at a DevOps hackathon at FAST NUCES. Our team designed, built, and shipped AWS infrastructure under a strict time limit.',
    detail: '₨65,000 prize',
    link: null,
    badge: '1st Place',
    badgeClass: 'badge-green',
  },
  {
    title: 'Platform Architecture Explained',
    date: 'August 2026',
    location: 'Cloud Native Karachi',
    description: 'How platforms fit together, and how to read one you did not build. Kubernetes, cert-manager, Argo, Flux, and Crossplane share one loop.',
    link: null,
    badge: 'Speaker',
    badgeClass: 'badge-blue',
  },
  {
    title: 'AWS Architecture in Action',
    date: 'September 2026',
    location: 'AWS SBG, SMIU',
    description: 'Hands-on session on designing a landing zone like a solutions architect: account structure, guardrails, and the full path from strategy to deployment.',
    link: null,
    badge: 'Speaker',
    badgeClass: 'badge-blue',
  },
  {
    title: 'Deep Dive into DevOps & Kubernetes',
    date: 'October 2026',
    location: 'Salim Habib University, Karachi',
    description: 'An introduction to DevOps and Kubernetes for computer science students, co-presented with Ameer Hamza and Muhammad Naimatullah Khan of Cloud Native Karachi.',
    link: null,
    badge: 'Speaker',
    badgeClass: 'badge-blue',
  },
  {
    title: 'Generative AI Infrastructure on AWS',
    date: 'November 2026',
    location: 'AWS Student Community, FAST NUCES',
    description: 'The compute, networking, AWS services, and models behind generative AI applications, and how they fit together in production. Co-presented with Ameer Hamza.',
    link: null,
    badge: 'Speaker',
    badgeClass: 'badge-blue',
  },
];

const community = {
  name: 'Cloud Native Karachi',
  logo: 'cncf',
  badge: 'Founding Organizer',
  date: 'July 2026 - present',
  role: 'CNCF Community Group',
  location: 'Karachi, Pakistan',
  summary: 'Founding organizer of Cloud Native Karachi, the city\'s first official CNCF Community Group. I wrote the proposal and mission statement, then cleared CNCF\'s LFC102, vendor-neutrality, and organizer-diversity requirements with two co-organizers from different companies. Approved on 22 July 2026.',  story: {
    heading: 'Why Karachi needed a chapter, and what we signed up to',
    body: `Karachi is Pakistan's largest tech hub, with thousands of engineers doing cloud and platform work, and it had no CNCF chapter. People either travelled or watched recordings. The request (${a('https://github.com/cncf/communitygroups/issues/761', 'cncf/communitygroups#761')}) went in on 14 June 2026, and CNCF provisioned the chapter on 22 July 2026 once the team's LFC102 credentials and company diversity were checked.

The charter is deliberately narrow. We meet at least once every 90 days, registration is free and always through the CNCF platform, and the content stays vendor-neutral: vendors are sponsors and speakers, not the agenda. We run technical talks and production war stories, hands-on workshops on CNCF projects, sessions on making a first upstream contribution, and outreach into Karachi universities.`,
  },
  links: [
    { href: 'https://ocgroups.dev/cncf/group/cn-khi', label: 'ocgroups.dev/cncf/group/cn-khi' },
    { href: 'https://github.com/cncf/communitygroups/issues/761', label: 'cncf/communitygroups #761' },
  ],
  tags: ['CNCF', 'Community', 'Kubernetes', 'Cloud Native', 'Karachi'],
};

type RawEntry = {
  type: string;
  typeLabel: string;
  name: string;
  logo?: string;
  date: string;
  lang?: string;
  links?: Array<{ href: string; label: string }>;
  link?: string;
  linkLabel?: string;
  summary: string;
  detail?: string | null;
  story?: { heading: string; body: string } | null;
  tags: string[];
};

// Normalise both shapes (links array vs single link) onto one entry record so
// the card component never has to branch.
const toLinks = (item: RawEntry) =>
  item.links ?? (item.link ? [{ href: item.link, label: item.linkLabel ?? item.link }] : []);

const entries = (contributions as unknown as RawEntry[]).map((item) => ({
  name: item.name,
  iconSvg: iconFor(item.logo)?.svg ?? null,
  typeLabel: item.typeLabel,
  badgeClass: item.type === 'maintainer' ? 'badge-blue' : 'badge-muted',
  date: item.date,
  lang: item.lang ?? null,
  place: null,
  summary: item.summary,
  detail: item.detail ?? null,
  story: item.story ?? null,
  links: toLinks(item),
  tags: item.tags,
}));

const communityEntry = {
  id: 'cncg',
  name: community.name,
  iconSvg: iconFor(community.logo)?.svg ?? null,
  typeLabel: community.badge,
  badgeClass: 'badge-orange',
  date: community.date,
  lang: community.role,
  place: community.location,
  summary: community.summary,
  detail: null,
  story: community.story,
  links: community.links,
  tags: community.tags,
};

const upstreamCount = entries.filter((e) => e.badgeClass === 'badge-muted').length;
const maintainedCount = entries.filter((e) => e.badgeClass === 'badge-blue').length;
---

<Base
  title="Contributions | Amaan Ul Haq Siddiqui"
  description="Upstream contributions, open source projects, and community recognition by Amaan Ul Haq Siddiqui."
  allPosts={allPostsData}
>
  <div class="stack">
    <header>
      <h1 class="page-title">Contributions</h1>
      <p class="page-lede" style="margin-top:1.25rem">
        Patches I landed upstream, tools I wrote and still maintain, and the community work
        that came out of both. Each entry links to the pull request, so none of it has to be
        taken on trust.
      </p>

      <div class="statstrip">
        <div class="stat">
          <span class="stat-n">{upstreamCount}</span>
          <span class="label">Upstream projects</span>
        </div>
        <div class="stat">
          <span class="stat-n">{maintainedCount}</span>
          <span class="label">Authored &amp; maintained</span>
        </div>
        <div class="stat">
          <span class="stat-n">{recognition.length}</span>
          <span class="label">Talks &amp; awards</span>
        </div>
      </div>
    </header>

    <!-- ── 01 Open source ───────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">01</span>
        <h2>Open source</h2>
        <span class="rule" aria-hidden="true"></span>
        <a class="action" href="https://github.com/amaanx86" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>

      <div class="entry-list">
        {entries.map((entry) => <Entry {...entry} />)}
      </div>
    </section>

    <!-- ── 02 Recognition ───────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">02</span>
        <h2>Recognition</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <div class="grid-2">
        {recognition.map((item) => (
          <article class="panel">
            <div class="entry-head">
              <div class="entry-ident">
                <h3 class="entry-name">{item.title}</h3>
                <p class="meta">{item.date} &middot; {item.location}</p>
              </div>
              <span class={`badge ${item.badgeClass}`}>{item.badge}</span>
            </div>
            <p class="entry-summary">{item.description}</p>
            {item.detail && <p class="entry-detail">{item.detail}</p>}
          </article>
        ))}
      </div>
    </section>

    <!-- ── 03 Community ─────────────────────────────────────────────── -->
    <section>
      <div class="section-head">
        <span class="idx">03</span>
        <h2>Community</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <Entry {...communityEntry} />
    </section>
  </div>
</Base>
