    date: 'October 2025',
    location: 'Dubai Knowledge Park, UAE',
    description: 'Spoke to ~200 practitioners on resilient AWS architectures and CI/CD security. Based on production patterns from client work and HackOps.',
    link: null,
    badge: 'Speaker',
    badgeClass: 'badge-blue',
  },
  {
    title: 'HackOps 2025: 1st Place',
    date: 'April 2025',
    location: 'FAST NUCES, Karachi',
    description: 'First place at a DevOps hackathon at FAST NUCES. Team built and shipped AWS infra under a time limit.',
    detail: '₨65,000 prize · State-level competition',
    link: null,
    badge: '1st Place',
    badgeClass: 'badge-green',
  },
];

const community = {
  name: 'Cloud Native Karachi',
  logo: 'cncf',
  badge: 'Founding Organizer',
  date: 'July 2026 - present',
  role: 'CNCF Community Group',
  location: 'Karachi, Pakistan',
  summary: 'Founding organizer of Cloud Native Karachi, the city\'s first official CNCF Community Group. I wrote the proposal and mission statement, then cleared CNCF\'s LFC102, vendor-neutrality, and organizer-diversity requirements with two co-organizers from different companies. Approved on 22 July 2026.',  story: {
    heading: 'Why Karachi needed a chapter, and what we signed up to',
    body: `Karachi is Pakistan's largest tech hub, with thousands of engineers doing cloud and platform work, and it had no CNCF chapter. People either travelled or watched recordings. The request (${a('https://github.com/cncf/communitygroups/issues/761', 'cncf/communitygroups#761')}) went in on 14 June 2026, and CNCF provisioned the chapter on 22 July 2026 once the team's LFC102 credentials and company diversity were checked.

The charter is deliberately narrow. We meet at least once every 90 days, registration is free and always through the CNCF platform, and the content stays vendor-neutral: vendors are sponsors and speakers, not the agenda. We run technical talks and production war stories, hands-on workshops on CNCF projects, sessions on making a first upstream contribution, and outreach into Karachi universities.`,
  },
  links: [
    { href: 'https://ocgroups.dev/cncf/group/cn-khi', label: 'ocgroups.dev/cncf/group/cn-khi' },
    { href: 'https://github.com/cncf/communitygroups/issues/761', label: 'cncf/communitygroups #761' },
  ],
  tags: ['CNCF', 'Community', 'Kubernetes', 'Cloud Native', 'Karachi'],
};
---

<Base
  title="Contributions | Amaan Ul Haq Siddiqui"
  description="Upstream contributions, open source projects, and community recognition by Amaan Ul Haq Siddiqui."
  allPosts={allPostsData}
>
  <div class="space-y-10">

    <div>
      <h1 class="font-mono text-2xl text-text font-semibold mb-2">Contributions</h1>
      <p class="text-muted text-sm">Upstream contributions, open source projects, and community recognition.</p>
    </div>

    <!-- ── Open source contributions ─────────────────────────────────── -->
    <section class="space-y-4">

      {contributions.map((item) => {
        const icon = iconFor((item as { logo?: string }).logo);
        return (
        <article class="card group border-l-4 border-l-transparent hover:border-l-accent transition-all duration-200">
          <!-- Header -->
          <div class="flex items-start justify-between gap-4 flex-wrap mb-3">
            <div class="flex items-center gap-2.5 flex-wrap">
              {icon && (
                <span
                  class="shrink-0 inline-flex items-center justify-center w-6 h-6 text-text [&>svg]:w-full [&>svg]:h-full [&>svg]:fill-current"
                  aria-hidden="true"
                  set:html={icon.svg}
                />
              )}
              <h2 class="font-mono text-base text-text font-semibold group-hover:text-accent transition-colors">
                {item.name}
              </h2>
              <span class={`badge ${item.type === 'maintainer' ? 'badge-blue' : 'badge-muted'}`}>
                {item.typeLabel}
              </span>
            </div>
            <div class="flex items-center gap-2 flex-wrap shrink-0">
              <span class="font-mono text-xs text-muted">{item.date}</span>
              <span class="font-mono text-xs text-muted bg-surface-raised border border-border rounded-full px-2.5 py-0.5">
                {item.lang}
              </span>
            </div>
          </div>

          <!-- Summary -->
          <p class="text-sm text-muted leading-relaxed mb-3">{item.summary}</p>

          {item.story && (
            <details class="group/story mb-3">
              <summary class="cursor-pointer list-none inline-flex items-center gap-1.5 font-mono text-xs text-accent bg-surface-raised border border-border rounded-full px-3 py-1 hover:border-accent transition-colors select-none mb-2">
                <svg class="w-2.5 h-2.5 transition-transform group-open/story:rotate-90 shrink-0" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M6 4l4 4-4 4"/>
                </svg>
                {item.story.heading}
              </summary>
              <div class="bg-surface-raised border border-border rounded-md p-4 space-y-3">
                {item.story.body.split('\n\n').map((para) => (
                  <p class="text-sm text-muted leading-relaxed" set:html={para} />
                ))}
              </div>
            </details>
          )}

          <!-- Detail -->
          {item.detail && (
            <p class="text-xs text-muted leading-relaxed mb-3 italic">{item.detail}</p>
          )}

          <!-- Footer -->
          <div class="flex items-center justify-between gap-3 flex-wrap pt-3 border-t border-border">
            <div class="flex flex-wrap gap-1.5">
              {item.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="flex flex-wrap gap-x-4 gap-y-1 justify-end">
              {item.links ? item.links.map((l: { href: string; label: string }) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-accent hover:text-accent-hover no-underline inline-flex items-center gap-1.5"
                >
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 3H3a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-4M10 1h5v5M15 1L7 9"/>
                  </svg>
                  {l.label}
                </a>
              )) : (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-accent hover:text-accent-hover no-underline inline-flex items-center gap-1.5"
                >
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 3H3a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-4M10 1h5v5M15 1L7 9"/>
                  </svg>
                  {item.linkLabel}
                </a>
              )}
            </div>
          </div>
        </article>
        );
      })}
    </section>

    <!-- ── Recognition ────────────────────────────────────────────────── -->
    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-muted tracking-[0.15em] uppercase">Community &amp; recognition</span>
        <div class="flex-1 h-px bg-border"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {recognition.map((item) => (
          <article class="card space-y-3">
            <div class="flex items-start justify-between gap-2">
              <h2 class="font-mono text-sm text-text font-semibold leading-snug">{item.title}</h2>
              <span class={`badge ${item.badgeClass} shrink-0`}>{item.badge}</span>
