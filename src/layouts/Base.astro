---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  allPosts?: Array<{ slug: string; title: string; description: string; tags: string[] }>;
  /** Widens the shell so a post can carry a contents rail beside the prose. */
  wide?: boolean;
}

const {
  title,
  description = 'DevOps & Cloud Security Engineer | Amaan Ul Haq Siddiqui',
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogImage = '/og-default.png',
  allPosts = [],
  wide = false,
} = Astro.props;

const ogImageURL = new URL(ogImage, Astro.site).toString();

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const webmentionUsername = Astro.site ? new URL(Astro.site).hostname : '';
const webmentionEndpoint = webmentionUsername
  ? `https://webmention.io/${webmentionUsername}/webmention`
  : '';

const navLinks = [
  { href: '/', label: 'Index' },
  { href: '/blog', label: 'Writing' },
  { href: '/projects', label: 'Contributions' },
  { href: '/verify', label: 'Verify' },
];

const externalLinks = [
  { href: 'https://github.com/amaanx86', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/amaanulhaqsiddiqui/', label: 'LinkedIn' },
  { href: 'https://www.credly.com/users/amaanx86', label: 'Credly' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Amaan Ul Haq Siddiqui" />
    <meta name="theme-color" content="#fcfaf6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content="g2wzBj0K1fTbsSn7_MU3y7yTfAR8NO5qXQ-edSQ3DFY" />
    <link rel="canonical" href={canonicalURL} />
    {webmentionEndpoint && <link rel="webmention" href={webmentionEndpoint} />}
    <link rel="me" href="https://github.com/amaanx86" />
    <link rel="me" href="https://gitlab.com/amaanx86" />

    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Amaan's Engineering Notes" />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={ogDescription || description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "5f48907720c34372ada4cebcc3b7943a"}'></script><!-- End Cloudflare Web Analytics -->

    <!-- Anti-FOUC: apply theme before paint -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class={`shell ${wide ? 'is-wide' : ''}`}>
      <!-- Rail: identity, index, controls -->
      <aside class="rail">
        <div>
          <a href="/" class="wordmark">amaan<em>x86</em></a>
          <p class="rail-sub">DevOps &amp;<br />Cloud Security</p>

          <nav class="rail-nav" aria-label="Primary">
            {navLinks.map((link, i) => (
              <a
                href={link.href}
                class={`rail-link ${isActive(link.href) ? 'active' : ''}`}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span>{link.label}</span>
              </a>
            ))}
          </nav>
        </div>

        <div class="rail-foot">
          <div class="rail-ext">
            {externalLinks.map((link) => (
              <a href={link.href} target="_blank" rel="me noopener noreferrer">{link.label}</a>
            ))}
          </div>

          <div class="rail-controls">
            <button id="search-trigger" class="icon-btn" aria-label="Search posts" title="Search (Cmd+K)">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6.5" cy="6.5" r="4.5" /><path d="M10.5 10.5L14 14" />
              </svg>
            </button>

            <button id="theme-toggle" class="icon-btn" aria-label="Toggle colour theme" title="Toggle light/dark">
              <svg id="icon-sun" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="hidden">
                <circle cx="8" cy="8" r="3" />
                <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" />
              </svg>
              <svg id="icon-moon" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13.5 10A5.5 5.5 0 016 2.5a5.5 5.5 0 100 11 5.5 5.5 0 007.5-3.5z" />
              </svg>
            </button>

            <button id="mobile-nav-toggle" class="icon-btn rail-burger" aria-label="Toggle navigation" aria-expanded="false">
              <svg id="icon-menu" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <path d="M2 4.5h12M2 8h12M2 11.5h12" />
              </svg>
              <svg id="icon-close" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="hidden">
                <path d="M12 4L4 12M4 4l8 8" />
              </svg>
            </button>
          </div>
        </div>
      </aside>

      <!-- Mobile drawer -->
      <nav id="mobile-nav" class="drawer" aria-label="Mobile">
        <div class="drawer-links">
          {navLinks.map((link, i) => (
            <a href={link.href} class={`rail-link ${isActive(link.href) ? 'active' : ''}`}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span>{link.label}</span>
            </a>
          ))}
        </div>
        <div class="drawer-ext">
          {externalLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="meta">{link.label}</a>
          ))}
        </div>
      </nav>

      <!-- Content -->
      <div class="content">
        <main id="main">
          <slot />
        </main>

        <footer class="site-footer">
          <p class="meta">
            Amaan Ul Haq Siddiqui &middot; GPG
            <a href="/verify">FC47DEE803DB612A</a>
          </p>
          <p class="meta">
            <a href="https://github.com/amaanx86/amaanx86.github.io" target="_blank" rel="noopener noreferrer">Source</a>
            <span aria-hidden="true"> / </span>
            <a href="/sitemap-index.xml">Sitemap</a>
          </p>
        </footer>
      </div>
    </div>

    <!-- Search modal -->
    <dialog id="search-modal" aria-label="Search posts">
      <div class="search-modal-box">
        <div class="search-modal-input-wrap">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6.5" cy="6.5" r="4.5" /><path d="M10.5 10.5L14 14" />
          </svg>
          <input
            id="modal-search-input"
            type="text"
            placeholder="Search posts by title, tag, or keyword"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
          />
          <kbd class="kbd">esc</kbd>
        </div>
        <div class="search-modal-results" id="modal-results">
          <p class="search-empty">Start typing to search</p>
        </div>
      </div>
    </dialog>

    <script is:inline define:vars={{ __allPosts: allPosts }}>
      window.__allPosts = __allPosts;
    </script>

    <script>
      // Theme
      const html = document.documentElement;
      const toggleBtn = document.getElementById('theme-toggle');
      const iconSun = document.getElementById('icon-sun');
      const iconMoon = document.getElementById('icon-moon');

      function applyTheme(theme: string) {
        const dark = theme === 'dark';
        html.classList.toggle('dark', dark);
        iconSun?.classList.toggle('hidden', !dark);
        iconMoon?.classList.toggle('hidden', dark);
        localStorage.setItem('theme', theme);
      }

      applyTheme(html.classList.contains('dark') ? 'dark' : 'light');
      toggleBtn?.addEventListener('click', () => {
        applyTheme(html.classList.contains('dark') ? 'light' : 'dark');
      });

      // Mobile drawer
      const mobileToggle = document.getElementById('mobile-nav-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      const iconMenu = document.getElementById('icon-menu');
      const iconClose = document.getElementById('icon-close');

      mobileToggle?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('open') ?? false;
        mobileToggle.setAttribute('aria-expanded', String(open));
        iconMenu?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      });

      // Search modal
      type Post = { slug: string; title: string; description: string; tags: string[] };

      const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
      const searchTrigger = document.getElementById('search-trigger');
      const modalInput = document.getElementById('modal-search-input') as HTMLInputElement | null;
      const modalResults = document.getElementById('modal-results');

      const posts: Post[] = (window as unknown as { __allPosts?: Post[] }).__allPosts || [];
      let cursor = 0;

      const ENTITIES: Record<string, string> = {
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      };
      function escapeHtml(value: string) {
        return value.replace(/[&<>"']/g, (ch) => ENTITIES[ch]);
      }

      function match(post: Post, q: string) {
        return (
          post.title.toLowerCase().includes(q) ||
          post.description.toLowerCase().includes(q) ||
          post.tags.some((t) => t.toLowerCase().includes(q))
        );
      }

      function renderResults(query: string) {
        if (!modalResults) return;
        const q = query.trim().toLowerCase();
        const filtered = q ? posts.filter((p) => match(p, q)) : posts;
        cursor = 0;

        if (!filtered.length) {
          modalResults.innerHTML = `<p class="search-empty">No posts match "${escapeHtml(query)}"</p>`;
          return;
        }

        modalResults.innerHTML = filtered
          .map(
            (p, i) => `
            <a href="/blog/${p.slug}" class="search-result-item${i === 0 ? ' is-selected' : ''}">
              <div class="result-title">${escapeHtml(p.title)}</div>
              <div class="result-desc">${escapeHtml(p.description)}</div>
            </a>`,
          )
          .join('');
      }

      function items() {
        return Array.from(
          modalResults?.querySelectorAll<HTMLAnchorElement>('.search-result-item') ?? [],
        );
      }

      function moveCursor(delta: number) {
        const list = items();
        if (!list.length) return;
        list[cursor]?.classList.remove('is-selected');
        cursor = (cursor + delta + list.length) % list.length;
        const next = list[cursor];
        next.classList.add('is-selected');
        next.scrollIntoView({ block: 'nearest' });
      }

      function openModal() {
        modal?.showModal();
        renderResults('');
        modalInput?.focus();
      }

      function closeModal() {
        modal?.close();
        if (modalInput) modalInput.value = '';
      }

      searchTrigger?.addEventListener('click', openModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      modal?.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (modal?.open) closeModal();
          else openModal();
        }
      });

      modal?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          moveCursor(1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          moveCursor(-1);
        } else if (e.key === 'Enter') {
          const target = items()[cursor];
          if (target) {
            e.preventDefault();
            window.location.href = target.href;
          }
        }
      });

      let debounceTimer: ReturnType<typeof setTimeout>;
      modalInput?.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        const value = (e.target as HTMLInputElement).value;
        debounceTimer = setTimeout(() => renderResults(value), 120);
      });
    </script>
  </body>
</html>
