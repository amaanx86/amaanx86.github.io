---
import Base from './Base.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  draft?: boolean;
  readingTime?: number;
}

const { title, description, date, tags, draft = false, readingTime = 1 } = Astro.props;

// Fetch all posts for the search modal
const allPostsRaw = await getCollection('blog', ({ data }) => !data.draft);
const allPosts = allPostsRaw.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
}));

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const mentionTargetUrl = new URL(Astro.url.pathname, Astro.site).toString();
const mentionCountApi = `https://webmention.io/api/count?target=${encodeURIComponent(mentionTargetUrl)}`;

const postUrl = mentionTargetUrl;
const year = date.getFullYear();
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
const bibtexKey = `siddiqui${year}${slug.split('-')[0]}`;

const githubUrl = `https://github.com/amaanx86/amaanx86.github.io/blob/main/src/content/blog/${slug}.md`;

const bibtex = `@misc{${bibtexKey},
  author       = {Siddiqui, Amaan Ul Haq},
  title        = {${title}},
  year         = {${year}},
  howpublished = {Amaan's Engineering Notes},
  url          = {${postUrl}},
  note         = {Source: ${githubUrl}},
  orcid        = {0009-0003-4839-9727}
}`;

const apa = `Siddiqui, A. U. H. (${year}, ${date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}). ${title}. Amaan's Engineering Notes. ${postUrl}`;
---

<Base
  title={`${title} | Amaan Ul Haq Siddiqui`}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  allPosts={allPosts}
>
  <!-- Scroll progress bar -->
  <div class="progress-bar" id="progress-bar"></div>

  <article>
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-muted mb-8">
      <a href="/" class="hover:text-accent">home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-accent">blog</a>
      <span>/</span>
      <span class="text-text truncate max-w-[200px] sm:max-w-none">{title}</span>
    </nav>

    <header class="mb-10">
      {draft && (
        <div class="mb-4">
          <span class="badge badge-orange">Draft</span>
        </div>
      )}

      <h1 class="font-mono text-2xl sm:text-3xl text-text leading-tight mb-5">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted font-mono">
        <time datetime={date.toISOString()} class="flex items-center gap-1.5">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="2" width="14" height="13" rx="2"/>
            <path d="M1 6h14M5 1v2M11 1v2"/>
          </svg>
          {formattedDate}
        </time>
        <span class="flex items-center gap-1.5">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="8" r="7"/>
            <path d="M8 4v4l3 2"/>
          </svg>
          {readingTime} min read
        </span>
        <span id="webmention-wrapper" class="flex items-center gap-1.5 hidden" title="Webmentions received for this post">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3h10v7H8l-3 3v-3H3z"/>
          </svg>
          <span id="webmention-count">0 mentions</span>
        </span>
      </div>

      <p class="mt-5 text-muted text-sm leading-relaxed max-w-prose border-l-2 border-border pl-4">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-5">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="border-t border-border mb-10"></div>

    <div class="prose" id="post-content">
      <slot />
    </div>

    <!-- Cite this post -->
    <div class="mt-12 pt-6 border-t border-border">
      <details id="cite-details">
        <summary class="font-mono text-xs text-muted hover:text-accent cursor-pointer flex items-center gap-2 select-none [list-style:none] [&::-webkit-details-marker]:hidden">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 4h2v4H3zm5 0h2v4H8zM3 8c0 2 1 3 2 3m5-3c0 2 1 3 2 3"/>
          </svg>
          Cite this post
          <svg id="cite-chevron" width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
            <path d="M4 6l4 4 4-4"/>
          </svg>
        </summary>

        <div class="mt-4">
          <div class="flex gap-1 mb-3">
            <button id="tab-bibtex" class="font-mono text-xs px-2.5 py-1 rounded border border-border bg-[var(--surface)] text-text cursor-pointer">BibTeX</button>
            <button id="tab-apa" class="font-mono text-xs px-2.5 py-1 rounded border border-transparent text-muted hover:text-text cursor-pointer">APA</button>
          </div>

          <div class="relative">
            <pre id="cite-bibtex" class="font-mono text-xs bg-[var(--surface)] border border-border rounded-lg p-4 overflow-x-auto text-muted leading-relaxed whitespace-pre-wrap break-all">{bibtex}</pre>
            <pre id="cite-apa" class="font-mono text-xs bg-[var(--surface)] border border-border rounded-lg p-4 overflow-x-auto text-muted leading-relaxed whitespace-pre-wrap break-all hidden">{apa}</pre>
            <button
              id="cite-copy"
              class="absolute top-2.5 right-2.5 font-mono text-xs text-muted hover:text-accent border border-border rounded px-2 py-0.5 bg-[var(--canvas)] cursor-pointer transition-colors"
            >
              copy
            </button>
          </div>
        </div>
      </details>
    </div>

    <div class="mt-6 pt-6 border-t border-border flex items-center justify-between">
      <a href="/blog" class="font-mono text-sm text-muted hover:text-accent flex items-center gap-2 group">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform">
          <path d="M10 12L6 8l4-4"/>
        </svg>
        Back to blog
      </a>
      <button
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="font-mono text-xs text-muted hover:text-accent flex items-center gap-1.5 cursor-pointer border-none bg-transparent"
      >
        Top
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 12V4M4 8l4-4 4 4"/>
        </svg>
      </button>
    </div>
  </article>

  <script is:inline define:vars={{ mentionCountApi, bibtex, apa }}>
    // Scroll progress bar
    const bar = document.getElementById('progress-bar');
    const content = document.getElementById('post-content');
    const mentionCountEl = document.getElementById('webmention-count');

    function updateProgress() {
      if (!bar || !content) return;
      const rect = content.getBoundingClientRect();
      const contentTop = rect.top + window.scrollY;
      const contentHeight = content.offsetHeight;
      const scrolled = window.scrollY - contentTop;
      const pct = Math.min(100, Math.max(0, (scrolled / contentHeight) * 100));
      bar.style.width = pct + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    // Cite this post — tab switching and copy
    const tabBibtex = document.getElementById('tab-bibtex');
    const tabApa = document.getElementById('tab-apa');
    const citeBibtex = document.getElementById('cite-bibtex');
    const citeApa = document.getElementById('cite-apa');
    const citeCopy = document.getElementById('cite-copy');
    const citeChevron = document.getElementById('cite-chevron');
    const citeDetails = document.getElementById('cite-details');

    let activeTab = 'bibtex';

    if (citeDetails) {
      citeDetails.addEventListener('toggle', () => {
        if (citeChevron) citeChevron.style.transform = citeDetails.open ? 'rotate(180deg)' : '';
      });
    }

    function setTab(tab) {
      activeTab = tab;
      const isB = tab === 'bibtex';
      if (citeBibtex) citeBibtex.classList.toggle('hidden', !isB);
      if (citeApa) citeApa.classList.toggle('hidden', isB);
      if (tabBibtex) {
        tabBibtex.classList.toggle('border-border', isB);
        tabBibtex.classList.toggle('bg-[var(--surface)]', isB);
        tabBibtex.classList.toggle('text-text', isB);
        tabBibtex.classList.toggle('border-transparent', !isB);
        tabBibtex.classList.toggle('text-muted', !isB);
      }
      if (tabApa) {
        tabApa.classList.toggle('border-border', !isB);
        tabApa.classList.toggle('bg-[var(--surface)]', !isB);
        tabApa.classList.toggle('text-text', !isB);
        tabApa.classList.toggle('border-transparent', isB);
        tabApa.classList.toggle('text-muted', isB);
      }
    }

    if (tabBibtex) tabBibtex.addEventListener('click', () => setTab('bibtex'));
    if (tabApa) tabApa.addEventListener('click', () => setTab('apa'));

    if (citeCopy) {
      citeCopy.addEventListener('click', () => {
        const text = activeTab === 'bibtex' ? bibtex : apa;
        navigator.clipboard.writeText(text).then(() => {
          citeCopy.textContent = 'copied!';
          setTimeout(() => { citeCopy.textContent = 'copy'; }, 2000);
        });
      });
    }

    fetch(mentionCountApi)
      .then((response) => {
        if (!response.ok) throw new Error('Failed to load mentions');
        return response.json();
      })
      .then((data) => {
        const count = typeof data?.count === 'number' ? data.count : 0;
        if (count > 0 && mentionCountEl) {
          mentionCountEl.textContent = count === 1 ? '1 mention' : `${count} mentions`;
          const wrapper = document.getElementById('webmention-wrapper');
          if (wrapper) wrapper.classList.remove('hidden');
        }
      })
      .catch(() => {
        if (mentionCountEl) mentionCountEl.textContent = 'Mentions unavailable';
      });
  </script>
</Base>
