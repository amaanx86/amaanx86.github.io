---
import Base from './Base.astro';
import { getCollection } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  draft?: boolean;
  readingTime?: number;
  headings?: Heading[];
}

const { title, description, date, tags, draft = false, readingTime = 1, headings = [] } = Astro.props;

const allPostsRaw = (await getCollection('blog', ({ data, id }) => !data.draft && !id.endsWith('.draft.md')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allPosts = allPostsRaw.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
}));

const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
const index = allPostsRaw.findIndex((p) => p.id === slug);
// The collection is newest-first, so the previous entry is the newer post.
const newer = index > 0 ? allPostsRaw[index - 1] : null;
const older = index >= 0 && index < allPostsRaw.length - 1 ? allPostsRaw[index + 1] : null;

// Only h2/h3 earn a place in the contents rail; deeper levels are noise.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const mentionTargetUrl = new URL(Astro.url.pathname, Astro.site).toString();
const mentionCountApi = `https://webmention.io/api/count?target=${encodeURIComponent(mentionTargetUrl)}`;

const postUrl = mentionTargetUrl;
const year = date.getFullYear();
const bibtexKey = `siddiqui${year}${slug.split('-')[0]}`;
const githubUrl = `https://github.com/amaanx86/amaanx86.github.io/blob/main/src/content/blog/${slug}.md`;

const bibtex = `@misc{${bibtexKey},
  author       = {Siddiqui, Amaan Ul Haq},
  title        = {${title}},
  year         = {${year}},
  howpublished = {Amaan's Engineering Notes},
  url          = {${postUrl}},
  note         = {Source: ${githubUrl}},
  orcid        = {0009-0003-4839-9727}
}`;

const apa = `Siddiqui, A. U. H. (${year}, ${date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}). ${title}. Amaan's Engineering Notes. ${postUrl}`;
---

<Base
  title={`${title} | Amaan Ul Haq Siddiqui`}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  allPosts={allPosts}
  wide={true}
>
  <div class="progress-bar" id="progress-bar"></div>

  <div class="post-layout">
    <article>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">index</a>
        <span aria-hidden="true">/</span>
        <a href="/blog">writing</a>
        <span aria-hidden="true">/</span>
        <span class="current">{slug}</span>
      </nav>

      <header class="post-header">
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">/</span>
          <span>{readingTime} min read</span>
          <span id="webmention-wrapper" class="hidden">
            <span aria-hidden="true">/</span>
            <span id="webmention-count">0 mentions</span>
          </span>
          {draft && <span class="badge badge-orange">Draft</span>}
        </div>

        <h1 class="post-title">{title}</h1>

        <p class="post-lede">{description}</p>

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </header>

      <div class="prose" id="post-content">
        <slot />
      </div>

      <!-- ── Cite ───────────────────────────────────────────────────── -->
      <section class="post-section">
        <details id="cite-details">
          <summary class="ghost-btn">
            <svg id="cite-chevron" width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 6l4 4 4-4" />
            </svg>
            Cite this post
          </summary>

          <div class="cite-body">
            <div class="cite-tabs">
              <button id="tab-bibtex" class="ghost-btn is-active">BibTeX</button>
              <button id="tab-apa" class="ghost-btn">APA</button>
            </div>
            <div class="cite-pre-wrap">
              <pre id="cite-bibtex" class="cite-pre">{bibtex}</pre>
              <pre id="cite-apa" class="cite-pre hidden">{apa}</pre>
              <button id="cite-copy" class="code-copy" style="opacity:1">copy</button>
            </div>
          </div>
        </details>
      </section>

      <!-- ── Adjacent posts ─────────────────────────────────────────── -->
      {(newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older ? (
            <a href={`/blog/${older.id}`} class="panel panel-link post-nav-item">
              <span class="label">Older</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a href={`/blog/${newer.id}`} class="panel panel-link post-nav-item is-next">
              <span class="label">Newer</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}

      <div class="post-footer">
        <a href="/blog" class="meta">&larr; All writing</a>
        <button id="to-top" class="meta" type="button">Back to top &uarr;</button>
      </div>
    </article>

    <!-- ── Contents rail ────────────────────────────────────────────── -->
    {toc.length > 1 && (
      <aside class="toc" aria-label="Table of contents">
        <p class="toc-title">Contents</p>
        <nav id="toc-nav">
          {toc.map((h) => (
            <a href={`#${h.slug}`} class={h.depth === 3 ? 'depth-3' : ''} data-toc={h.slug}>
              {h.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>

  <script is:inline define:vars={{ mentionCountApi, bibtex, apa }}>
    // ─── Reading progress ────────────────────────────────────────────
    const bar = document.getElementById('progress-bar');
    function updateProgress() {
      if (!bar) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
      bar.style.width = pct + '%';
    }
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    document.getElementById('to-top')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // ─── Code blocks: language chip + copy ───────────────────────────
    document.querySelectorAll('#post-content pre.astro-code').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const lang = pre.getAttribute('data-language');
      if (lang && lang !== 'plaintext') {
        const chip = document.createElement('span');
        chip.className = 'code-chip';
        chip.textContent = lang;
        wrap.appendChild(chip);
      }

      const btn = document.createElement('button');
      btn.className = 'code-copy';
      btn.type = 'button';
      btn.textContent = 'copy';
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(pre.innerText).then(() => {
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = 'copy'; }, 1800);
        });
      });
      wrap.appendChild(btn);
    });

    // ─── Heading anchors ─────────────────────────────────────────────
    document.querySelectorAll('#post-content h2[id], #post-content h3[id]').forEach((h) => {
      const a = document.createElement('a');
      a.className = 'heading-anchor';
      a.href = '#' + h.id;
      a.setAttribute('aria-label', 'Link to this section');
      a.textContent = '#';
      h.appendChild(a);
    });

    // ─── Contents scroll-spy ─────────────────────────────────────────
    const tocLinks = Array.from(document.querySelectorAll('#toc-nav a'));
    if (tocLinks.length) {
      const bySlug = new Map(tocLinks.map((a) => [a.dataset.toc, a]));
      const targets = tocLinks
        .map((a) => document.getElementById(a.dataset.toc))
        .filter(Boolean);

      let current = null;
      function setActive(id) {
        if (id === current) return;
        current = id;
        tocLinks.forEach((a) => a.classList.toggle('active', a.dataset.toc === id));
      }

      const observer = new IntersectionObserver(
        () => {
          // Active heading = the last one whose top has passed the marker line.
          const marker = window.innerHeight * 0.25;
          let active = targets[0];
          for (const t of targets) {
            if (t.getBoundingClientRect().top <= marker) active = t;
          }
          if (active) setActive(active.id);
        },
        { rootMargin: '0px 0px -70% 0px', threshold: [0, 1] },
      );
      targets.forEach((t) => observer.observe(t));

      window.addEventListener('scroll', () => {
        const marker = window.innerHeight * 0.25;
        let active = targets[0];
        for (const t of targets) {
          if (t.getBoundingClientRect().top <= marker) active = t;
        }
        if (active) setActive(active.id);
      }, { passive: true });

      tocLinks.forEach((a) => {
        if (bySlug.get(a.dataset.toc)) a.addEventListener('click', () => setActive(a.dataset.toc));
      });
    }

    // ─── Cite block ──────────────────────────────────────────────────
    const tabBibtex = document.getElementById('tab-bibtex');
    const tabApa = document.getElementById('tab-apa');
    const citeBibtex = document.getElementById('cite-bibtex');
    const citeApa = document.getElementById('cite-apa');
    const citeCopy = document.getElementById('cite-copy');
    const citeChevron = document.getElementById('cite-chevron');
    const citeDetails = document.getElementById('cite-details');

    let activeTab = 'bibtex';

    citeDetails?.addEventListener('toggle', () => {
      if (citeChevron) citeChevron.style.transform = citeDetails.open ? 'rotate(180deg)' : '';
    });

    function setTab(tab) {
      activeTab = tab;
      const isB = tab === 'bibtex';
      citeBibtex?.classList.toggle('hidden', !isB);
      citeApa?.classList.toggle('hidden', isB);
      tabBibtex?.classList.toggle('is-active', isB);
      tabApa?.classList.toggle('is-active', !isB);
    }

    tabBibtex?.addEventListener('click', () => setTab('bibtex'));
    tabApa?.addEventListener('click', () => setTab('apa'));

    citeCopy?.addEventListener('click', () => {
      navigator.clipboard.writeText(activeTab === 'bibtex' ? bibtex : apa).then(() => {
        citeCopy.textContent = 'copied';
        setTimeout(() => { citeCopy.textContent = 'copy'; }, 1800);
      });
    });

    // ─── Webmentions ─────────────────────────────────────────────────
    fetch(mentionCountApi)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('mentions unavailable'))))
      .then((data) => {
        const count = typeof data?.count === 'number' ? data.count : 0;
        if (count > 0) {
          const el = document.getElementById('webmention-count');
          if (el) el.textContent = count === 1 ? '1 mention' : count + ' mentions';
          document.getElementById('webmention-wrapper')?.classList.remove('hidden');
        }
      })
      .catch(() => {});
  </script>
</Base>
